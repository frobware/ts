#!/usr/bin/env bash
#
# Behavioural checks for ts, run against a built binary.
#
#   $ hack/check build/bin/ts
#
# The unit tests compiled into ts run on every invocation, so every
# case below exercises those as well as the behaviour it asserts.

set -uo pipefail

TS=${1:-build/bin/ts}

if [[ ! -x $TS ]]; then
    echo "no such binary: $TS" >&2
    exit 1
fi

failures=0

# expect DESCRIPTION EXPECTED ACTUAL
expect() {
    if [[ $3 == "$2" ]]; then
        printf 'ok   %s\n' "$1"
    else
        printf 'FAIL %s\n       expected: %q\n       actual:   %q\n' "$1" "$2" "$3"
        failures=$((failures + 1))
    fi
}

# expect_match DESCRIPTION REGEX ACTUAL
expect_match() {
    if [[ $3 =~ $2 ]]; then
        printf 'ok   %s\n' "$1"
    else
        printf 'FAIL %s\n       expected match: %s\n       actual:         %q\n' "$1" "$2" "$3"
        failures=$((failures + 1))
    fi
}

# expect_rejected DESCRIPTION REGEX ARGS... -- ts must both exit
# non-zero and explain itself. Asserting only the status would hold
# for any failing binary, and asserting only the diagnostic would
# accept one that complains and then carries on.
expect_rejected() {
    local what=$1 pattern=$2 out status
    shift 2
    out=$(echo line | "$TS" "$@" 2>&1 >/dev/null)
    status=$?
    if (( status == 0 )); then
        printf 'FAIL %s\n       expected a non-zero exit, got 0\n' "$what"
        failures=$((failures + 1))
    elif [[ ! $out =~ $pattern ]]; then
        printf 'FAIL %s (exit %d)\n       expected match: %s\n       actual:         %q\n' \
            "$what" "$status" "$pattern" "$out"
        failures=$((failures + 1))
    else
        printf 'ok   %s\n' "$what"
    fi
}

# run_ts TZ ARGS... -- run ts over $dated with TZ set, leaving its
# stdout in $ts_out. A non-zero exit or empty output is recorded as a
# failure and $ts_out is replaced by a value unique to this call, so
# that comparing two unsuccessful runs cannot report a match.
ts_out=""
run_count=0
run_ts() {
    local tz=$1 status
    shift
    run_count=$((run_count + 1))
    ts_out=$(echo "$dated" | TZ=$tz "$TS" "$@" 2>/dev/null)
    status=$?
    if (( status != 0 )); then
        printf 'FAIL ts %s (TZ=%s) exited %d\n' "$*" "$tz" "$status"
        failures=$((failures + 1))
        ts_out="<run $run_count failed>"
    elif [[ -z $ts_out ]]; then
        printf 'FAIL ts %s (TZ=%s) printed nothing\n' "$*" "$tz"
        failures=$((failures + 1))
        ts_out="<run $run_count empty>"
    fi
}

dated="16 Jun 94 07:29:35 +0000 event"

expect_match "default format is '%b %d %H:%M:%S'" \
    '^[A-Z][a-z][a-z] [0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] line$' \
    "$(echo line | "$TS")"

expect "a format argument overrides the default" \
    "$(date +%Y) line" \
    "$(echo line | "$TS" '%Y')"

expect "-s starts from zero" \
    "00:00:00 line" \
    "$(echo line | "$TS" -s)"

expect "-i starts from zero" \
    "00:00:00 line" \
    "$(echo line | "$TS" -i)"

expect "a format argument overrides the -s default" \
    "elapsed 00:00:00 line" \
    "$(echo line | "$TS" -s 'elapsed %H:%M:%S')"

# An elapsed time is not a point in time, so TZ must not shift it.
for tz in UTC Europe/London Asia/Tokyo; do
    expect "-s ignores TZ=$tz" \
        "00:00:00 line" \
        "$(echo line | TZ=$tz "$TS" -s)"
done

expect "-r reformats a timestamp to an explicit format" \
    "1994-06-16 07:29:35 event" \
    "$(echo "$dated" | TZ=UTC "$TS" -r '%F %T')"

# -r supersedes -i and -s rather than being corrupted by them. What
# strftime prints is the struct strptime filled, and how an explicit
# +0000 offset survives mktime differs between libcs -- glibc leaves
# the fields alone where BSD shifts them into the local zone -- so
# assert that -i and -s change nothing, not a literal time.
for tz in UTC Europe/London Asia/Tokyo; do
    run_ts "$tz" -r '%F %T'
    plain=$ts_out

    run_ts "$tz" -r -s '%F %T'
    expect "-r -s matches -r under TZ=$tz" "$plain" "$ts_out"

    run_ts "$tz" -r -i '%F %T'
    expect "-r -i matches -r under TZ=$tz" "$plain" "$ts_out"
done

run_ts UTC -r
plain=$ts_out

run_ts UTC -r -i -s
expect "-r -i -s is still just -r" "$plain" "$ts_out"

run_ts UTC -r -s
expect "-r -s is relative, not an elapsed delta" "$plain" "$ts_out"

# One instant, written three ways: with a Z suffix, with a zero
# numeric offset, and with a shifted clock and matching offset. All
# three name the same moment, so ts must render them identically in
# any zone. The libcs cannot be made to agree on this through strptime
# and mktime alone: glibc leaves the offset in tm_gmtoff and mktime
# ignores it, whilst BSD rewrites the fields into the local zone.
#
# These compare rendered timestamps rather than relative ages, since
# an age moves under the test as the clock ticks.
zulu="1994-06-16T07:29:35.000000000Z event"
zero_offset="16 Jun 94 07:29:35 +0000 event"
plus_two="16 Jun 94 09:29:35 +0200 event"

for tz in UTC Europe/London Asia/Tokyo America/Los_Angeles Australia/Sydney; do
    rendered=$(echo "$zulu" | TZ=$tz "$TS" -r '%F %T')

    expect_match "a Z timestamp renders as a date under TZ=$tz" \
        '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} event$' \
        "$rendered"

    expect "+0000 agrees with Z under TZ=$tz" \
        "$rendered" \
        "$(echo "$zero_offset" | TZ=$tz "$TS" -r '%F %T')"

    expect "+0200 agrees with Z under TZ=$tz" \
        "$rendered" \
        "$(echo "$plus_two" | TZ=$tz "$TS" -r '%F %T')"
done

# Absolute renderings, in two zones whose June 1994 offset is not in
# doubt: UTC, and Tokyo at a fixed +9 with no daylight saving.
expect "a Z timestamp renders as 07:29:35 under TZ=UTC" \
    "1994-06-16 07:29:35 event" \
    "$(echo "$zulu" | TZ=UTC "$TS" -r '%F %T')"

expect "a Z timestamp renders as 16:29:35 under TZ=Asia/Tokyo" \
    "1994-06-16 16:29:35 event" \
    "$(echo "$zulu" | TZ=Asia/Tokyo "$TS" -r '%F %T')"

# A fractional part of any length, with or without the Z, belongs to
# the timestamp and must not be left stranded in the output.
for frac in ".000000000Z" ".123456Z" ".123Z" "Z" ".123456789" ".123" ""; do
    expect "an ISO-8601 timestamp absorbs the suffix '''$frac'''" \
        "1994-06-16 07:29:35 event" \
        "$(echo "1994-06-16T07:29:35$frac event" | TZ=UTC "$TS" -r '%F %T')"
done

# A timestamp with no zone names no instant, so it stays as written
# and TZ decides what it meant.
expect "-r leaves a zone-less timestamp as written" \
    "1994-06-16 07:29:35 event" \
    "$(echo "1994-06-16T07:29:35 event" | TZ=Asia/Tokyo "$TS" -r '%F %T')"

expect_rejected "-i -s is rejected" "cannot be used together" -i -s
expect_rejected "-p 0 is rejected" "out of range" -p 0
expect_rejected "an unknown option is rejected" "Usage: ts " -z

if (( failures > 0 )); then
    printf '\n%d check(s) failed\n' "$failures" >&2
    exit 1
fi

echo
echo "all checks passed"
